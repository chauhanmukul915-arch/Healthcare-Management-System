<%@ page contentType="text/html;charset=UTF-8" %>
<%
String ctx=request.getContextPath();
String current=request.getRequestURI();
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%=pageTitle%> · CarePoint</title><link rel="stylesheet" href="<%=ctx%>/assets/css/style.css"></head><body>
<div class="app-shell"><aside class="sidebar"><a class="brand" href="<%=ctx%>/dashboard"><span class="brand-mark small">✚</span><span>CarePoint<small>HEALTH MANAGEMENT</small></span></a>
<nav class="nav-links">
<a class="<%=current.endsWith("/dashboard")?"active":""%>" href="<%=ctx%>/dashboard">▦ <span>Overview</span></a>
<a class="<%=current.endsWith("/patients")?"active":""%>" href="<%=ctx%>/patients">♙ <span>Patients</span></a>
<a class="<%=current.endsWith("/doctors")?"active":""%>" href="<%=ctx%>/doctors">✚ <span>Doctors</span></a>
<a class="<%=current.endsWith("/appointments")?"active":""%>" href="<%=ctx%>/appointments">▣ <span>Appointments</span></a>
<a class="<%=current.endsWith("/billing")?"active":""%>" href="<%=ctx%>/billing">＄ <span>Billing</span></a>
</nav><div class="sidebar-bottom"><div class="user-avatar"><%=com.healthcare.util.Html.escape(session.getAttribute("user"))%></div><div class="user-meta"><b><%=com.healthcare.util.Html.escape(session.getAttribute("user"))%></b><small>Signed in</small></div><a class="logout" href="<%=ctx%>/logout" title="Sign out">↗</a></div></aside>
<div class="main-area"><header class="topbar"><div><span class="eyebrow">WORKSPACE / <%=pageTitle.toUpperCase()%></span><h2><%=pageTitle%></h2></div><div class="topbar-right"><span class="status-dot"></span><span>System online</span><div class="top-avatar">CP</div></div></header><main class="content">
<% if(request.getParameter("success")!=null){ %><div class="alert success"><%=com.healthcare.util.Html.escape(request.getParameter("success"))%></div><% } %>
<% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=com.healthcare.util.Html.escape(request.getAttribute("error"))%></div><% } %>
